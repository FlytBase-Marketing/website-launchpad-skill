# Copy to .env.local and fill in. Never commit .env.local.
# Names only here; values live in .env.local and in Vercel (Settings > Environment Variables).
# Browser-exposed prefixes (NEXT_PUBLIC_, PUBLIC_, NUXT_PUBLIC_, VITE_) are PUBLIC: never put a secret behind them.

# Production URL of the site, used for canonicals, sitemap and Open Graph.
# Next.js: SITE_URL / Nuxt: NUXT_PUBLIC_SITE_URL / SvelteKit: PUBLIC_SITE_URL / Astro: set "site" in astro.config
SITE_URL=

# Sanity (project ID and dataset are not secret)
# Rename with the framework's public prefix if browser code needs them, e.g. NEXT_PUBLIC_SANITY_PROJECT_ID
SANITY_PROJECT_ID=
SANITY_DATASET=production
# A fixed date (YYYY-MM-DD), usually the day you set it up. Change it on purpose, never "latest".
SANITY_API_VERSION=

# Sanity tokens: SERVER ONLY. Viewer token for drafts/preview.
SANITY_API_READ_TOKEN=
# Secret shared with the Sanity webhook that revalidates pages.
SANITY_REVALIDATE_SECRET=

# Forms / CRM (server only)
# HUBSPOT_ACCESS_TOKEN=
# TURNSTILE_SECRET_KEY=
